# Google AI Studio 에서 발급한 Gemini API 키 (필수) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini 모델 폴백 순서 (선택, 쉼표 구분). 비우면 코드 기본값 사용:
# gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3-flash-preview
GEMINI_MODELS=

# 포켓몬 데이터 소스 강제 비활성화 (선택, 테스트용, 쉼표 구분)
# 가능한 값: pokemon-go-api, pvpoke, pogoapi, pokeminers
POGO_DISABLE_SOURCES=

# 포켓몬 데이터 메모리 캐시 유지 시간(ms) (선택, 기본 6시간 = 21600000)
POKEMON_DATA_TTL_MS=

# PokeMiners 원본 파싱 결과 캐시 시간(ms) (선택, 기본 24시간 = 86400000)
POKEMINERS_TTL_MS=

# 갱신 시각이 이 일수 이상 지난 소스는 다수결 투표에서 제외 (선택, 기본 60)
SOURCE_STALE_DAYS=

# 분석 요청 시 Gemini 에 보내는 프롬프트를 서버 로그에 출력 (선택, 디버그용, 1 로 설정)
POGO_DEBUG_PROMPT=
