# Google AI Studio 에서 발급한 Gemini API 키 (필수) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Supabase (1단계: 익명 계정 · 내 포켓몬 목록 · AI 사용 횟수) ───
# Vercel Marketplace 연동 시 자동 등록되는 이름을 그대로 쓴다. 신형 키(PUBLISHABLE/SECRET) 우선, 없으면 구형 키로 대체.
# 클라이언트(브라우저 번들 포함):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=            # 구형 (publishable key 없을 때만)
# 서버 전용(절대 클라이언트에 노출 금지):
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=                # 구형 (secret key 없을 때만)
# DB 직접 접속(마이그레이션 실행용, 앱 코드에서는 사용하지 않음): POSTGRES_URL, POSTGRES_URL_NON_POOLING

# AI 사용 횟수 날짜 기준 시간대 (선택, 기본 America/Los_Angeles = Gemini 일일 한도 초기화 기준)
AI_USAGE_TZ=
NEXT_PUBLIC_AI_USAGE_TZ=

# Gemini 모델 폴백 순서 (선택, 쉼표 구분). 비우면 코드 기본값 사용:
# gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3-flash-preview
GEMINI_MODELS=

# Gemini thinking 수준 (선택, 기본 low). minimal/low/medium/high, "off" 면 파라미터를 보내지 않음
GEMINI_THINKING_LEVEL=

# 포켓몬 데이터 소스 강제 비활성화 (선택, 테스트용, 쉼표 구분)
# 가능한 값: pokemon-go-api, pvpoke, pogoapi, pokeminers
POGO_DISABLE_SOURCES=

# 포켓몬 데이터 메모리 캐시 유지 시간(ms) (선택, 기본 6시간 = 21600000)
POKEMON_DATA_TTL_MS=

# PokeMiners 원본 파싱 결과 캐시 시간(ms) (선택, 기본 24시간 = 86400000)
POKEMINERS_TTL_MS=

# 갱신 시각이 이 일수 이상 지난 소스는 다수결 투표에서 제외 (선택, 기본 60)
SOURCE_STALE_DAYS=

# 분석 요청 시 Gemini 에 보내는 프롬프트를 서버 로그에 출력 (선택, 디버그용, 1 로 설정)
POGO_DEBUG_PROMPT=

# 응답 본문이 이 글자 수 미만이면 비정상으로 보고 다음 모델로 재시도 (선택, 기본 400)
GEMINI_MIN_CHARS=
# 박사 코멘트(mode=team, 3~5줄)의 짧은 응답 기준 (선택, 기본 60)
GEMINI_MIN_CHARS_TEAM=

# Gemini 엔드포인트 (테스트용 모의 서버 지정에만 사용, 기본 https://generativelanguage.googleapis.com)
GEMINI_API_BASE=
